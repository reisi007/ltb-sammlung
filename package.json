{
  "name": "ltb-sammlung",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persönliche Übersicht meiner Lustiges-Taschenbuch-Sammlung",
  "repository": {
    "type": "git",
    "url": "https://github.com/reisi007/ltb-sammlung.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/ensure-data.mjs",
    "build": "vite build",
    "prebuild": "node scripts/ensure-data.mjs",
    "preview": "vite preview",
    "pretypecheck": "node scripts/ensure-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/assert-no-collection-data.mjs dist",
    "sync:data": "node scripts/sync-collection.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "icons": "node scripts/generate-icons.mjs",
    "data:check": "node scripts/ensure-data.mjs --check",
    "test:api": "php api/tests/run.php",
    "lint:api": "php -l api/index.php && php -l api/src/Api.php && php -l api/src/Catalog.php && php -l api/src/Store.php && php -l api/src/Validation.php && php -l api/bin/user.php && php -l api/bin/vacuum.php && php -l api/tests/run.php",
    "test:screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lingui/cli": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "daisyui": "5.8.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
